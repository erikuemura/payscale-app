# Copie para .env.local. Use um projeto Supabase de desenvolvimento.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUBSTITUA_PELA_CHAVE_PUBLICA
# Exclusivamente servidor; nunca use prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SERVICE_ROLE_KEY=SUBSTITUA_PELA_CHAVE_ADMINISTRATIVA

# Somente após aplicar 006a e validar RLS em desenvolvimento. Desativado por padrão.
# RECONCILIATION_HISTORY_ENABLED=true

# API de contato: manter desligada até validação de domínio/remetente e antispam.
# CONTACT_FORM_ENABLED=true
# RESEND_API_KEY=chave_somente_no_servidor
# CONTACT_FROM=PayScale <site@payscale.com.br>
# TURNSTILE_SECRET_KEY=chave_somente_no_servidor

# Keep disabled until migrations + two-user Auth/Data API/Storage tests pass.
DISPUTE_WORKSPACE_ENABLED=false
COMMERCIAL_REQUESTS_ENABLED=false
